# Environment Variables for E2E Testing
# Copia questo file in .env.test (nella root del repo) e inserisci i tuoi valori reali.
# IMPORTANT: non committare mai .env.test con valori reali.

# Supabase Configuration
VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Test Configuration
NODE_ENV=test
