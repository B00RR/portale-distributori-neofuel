{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 3,
      "puppeteerScript": "./scripts/lighthouse-auth.cjs",
      "settings": {
        "preset": "desktop"
      },
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/#admin/dashboard",
        "http://localhost:8080/#admin/shifts",
        "http://localhost:8080/#admin/vouchers",
        "http://localhost:8080/#admin/invoices",
        "http://localhost:8080/#operator/apertura"
      ]
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.7
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.8
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
