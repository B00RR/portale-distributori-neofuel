#!/bin/sh
# Husky pre-commit hook
# Esegue ESLint prima di ogni commit

echo "🔍 Running ESLint..."

# Esegui lint solo sui file staged (js/ts/jsx/tsx)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(js|jsx|ts|tsx)$')

# Nessun file rilevante: salta il lint
if [ -z "$STAGED_FILES" ]; then
  echo "ℹ️  Nessun file JS/TS staged, ESLint saltato."
  exit 0
fi

# Esegui ESLint (flat config: eslint.config.js)
echo "$STAGED_FILES" | xargs npx eslint --cache --fix

# Se ESLint fallisce, blocca il commit
if [ $? -ne 0 ]; then
  echo "❌ ESLint ha trovato errori. Correggi prima di committare."
  exit 1
fi

echo "✅ ESLint passed!"

# Riaggiungi i file modificati da --fix
echo "$STAGED_FILES" | xargs git add

exit 0
