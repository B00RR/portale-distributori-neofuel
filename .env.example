# Environment Variables Template
# Copia questo file in .env e inserisci i tuoi valori reali
#
# IMPORTANT: Le variabili DEVONO avere il prefisso VITE_ per essere
# esposte al client dal bundler. Senza il prefisso, Vite le ignora
# e l'app crasha con "supabaseUrl is required".

# Supabase Configuration
VITE_SUPABASE_URL=your-project-url-here
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Example:
# VITE_SUPABASE_URL=https://yourproject.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbG...VCJ9...

# Live E2E tests configuration (issue #131, hardened in #309)
# Default npm run test:e2e is hermetic and uses mocked Supabase.
# To seed and run against a live disposable Supabase project, set E2E_SUPABASE_MODE=live
# and ALL required security parameters below.
#
# Safety guards (#309):
# - ALLOW_E2E_SEED=1 (explicit opt-in flag required)
# - E2E_ALLOWED_PROJECT_REFS: comma-separated list of allowed disposable project refs
# - PRODUCTION_SUPABASE_PROJECT_REF: production project ref (ALWAYS rejected by seed guard)
# - E2E_RUN_ID: unique 3-32 char alphanumeric/dash run identifier for fixture isolation & cleanup
# - Explicit admin/operator credentials with NO fallback
E2E_SUPABASE_MODE=mock
ALLOW_E2E_SEED=0
E2E_TARGET_PROJECT_REF=your-target-project-ref-here
E2E_ALLOWED_PROJECT_REFS=your-disposable-ref-1,your-disposable-ref-2
PRODUCTION_SUPABASE_PROJECT_REF=your-production-ref-here
E2E_RUN_ID=run-001
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
TEST_ADMIN_USERNAME=e2e-admin
TEST_ADMIN_PASSWORD=your-secure-test-admin-password-here
TEST_OPERATOR_USERNAME=e2e-operator
TEST_OPERATOR_PASSWORD=your-secure-test-operator-password-here
TEST_STATION_NAME=Stazione E2E Neofuel
TEST_STATION_LOCATION=E2E
