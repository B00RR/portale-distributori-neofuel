{
  "name": "portale-distributori-neofuel",
  "version": "1.2.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run -c config/vitest.config.ts",
    "test:watch": "vitest -c config/vitest.config.ts",
    "test:coverage": "vitest run -c config/vitest.config.ts --coverage",
    "test:ui": "vitest --ui -c config/vitest.config.ts",
    "test:e2e": "playwright test -c config/playwright.config.js",
    "test:e2e:ui": "playwright test --ui -c config/playwright.config.js",
    "test:e2e:headed": "playwright test --headed -c config/playwright.config.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint js --max-warnings 0",
    "lint:fix": "eslint js --fix",
    "lint:security": "eslint js",
    "format": "prettier --write \"js/**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"js/**/*.{js,ts,json}\"",
    "audit": "npm audit --production",
    "audit:fix": "npm audit fix",
    "secure": "npm run lint:security && npm run audit && npm run type-check",
    "test:e2e:live": "E2E_SUPABASE_MODE=live playwright test -c config/playwright.config.js",
    "db:types": "supabase gen types typescript --linked --schema public > supabase/database.types.ts",
    "db:types:check": "supabase gen types typescript --linked --schema public > /tmp/database.types.live.ts && diff -u supabase/database.types.ts /tmp/database.types.live.ts",
    "db:migrations:verify": "tsx scripts/verify-migrations.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@playwright/test": "^1.57.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "@vitest/coverage-v8": "^4.0.18",
    "dotenv": "^17.2.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-unsanitized": "^4.1.4",
    "eslint-plugin-promise": "^7.2.1",
    "eslint-plugin-security": "^3.0.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "happy-dom": "^20.3.4",
    "jsdom": "^27.0.1",
    "lit": "^3.2.1",
    "postcss": "^8.5.23",
    "prettier": "3.9.3",
    "terser": "^5.44.1",
    "tsx": "^4.23.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.53.0",
    "vite": "^6.0.5",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@supabase/supabase-js": "2.94.1",
    "chart.js": "^4.5.1",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "qrcode": "^1.5.4",
    "sortablejs": "^1.15.7",
    "split.js": "^1.6.5",
    "vite-plugin-pwa": "^1.2.0",
    "zod": "^4.3.5"
  },
  "overrides": {
    "ws": "^8.21.1",
    "fast-uri": "4.1.1",
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.5",
    "@eslint/config-array": "^0.23.5",
    "@eslint/eslintrc": "^3.3.6"
  }
}
