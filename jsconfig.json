{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2022",
            "DOM",
            "DOM.Iterable"
        ],
        "allowJs": true,
        "checkJs": true,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "esModuleInterop": true,
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "js/*"
            ],
            "@core/*": [
                "js/core/*"
            ],
            "@utils/*": [
                "js/utils/*"
            ],
            "@ui/*": [
                "js/ui/*"
            ],
            "@admin/*": [
                "js/admin/*"
            ],
            "@operator/*": [
                "js/operator/*"
            ],
            "@shared/*": [
                "js/shared/*"
            ]
        }
    },
    "include": [
        "js/**/*.js"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "js/utils/template_chiusura_base64.js"
    ]
}